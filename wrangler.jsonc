{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "procurement-sourcing-gateway",
	"main": "cloudflare/gateway/src/index.ts",
	"compatibility_date": "2026-10-13",
	"compatibility_flags": ["nodejs_compat"],
	// The public demo is served from this Worker, so the page and the API
	// share one origin and the guest session cookie works without a login.
	"assets": {
		"directory": "frontend/dist",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"containers": [
		{
			"class_name": "SourcingContainer",
			"image": "./Dockerfile",
			"instance_type": "standard-4",
			"max_instances": 2
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SOURCING_CONTAINER",
				"class_name": "SourcingContainer"
			}
		]
	},
	"exports": {
		"SourcingContainer": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"workflows": [
		{
			"name": "procurement-sourcing-run",
			"binding": "WORKFLOW",
			"class_name": "SourcingWorkflow"
		},
		{
			"name": "procurement-sourcing-compile",
			"binding": "COMPILE_WORKFLOW",
			"class_name": "SourcingCompileWorkflow"
		},
		{
			"name": "procurement-sourcing-spec",
			"binding": "SPEC_WORKFLOW",
			"class_name": "SourcingSpecWorkflow"
		},
		{
			"name": "procurement-sourcing-decision",
			"binding": "DECISION_WORKFLOW",
			"class_name": "SourcingDecisionWorkflow"
		},
		{
			"name": "procurement-sourcing-report",
			"binding": "REPORT_WORKFLOW",
			"class_name": "SourcingReportWorkflow"
		},
		{
			"name": "procurement-sourcing-acceptance",
			"binding": "ACCEPTANCE_WORKFLOW",
			"class_name": "SourcingAcceptanceWorkflow"
		},
		{
			"name": "procurement-sourcing-pipeline",
			"binding": "PIPELINE_WORKFLOW",
			"class_name": "ProcurementPipelineWorkflow"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "procurement-sourcing",
			"database_id": "3a67c338-107f-4053-b678-109dd218773c",
			"migrations_dir": "cloudflare/gateway/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "procurement-sourcing-artifacts"
		}
	],
	"vars": {
		"CONTAINER_GATEWAY_URL": "https://procurement-sourcing-gateway.xiangyu474.workers.dev",
		// A running container keeps the image it was started with. Bump this
		// name to bring a new image into service: the next request starts a
		// container from the image of this deployment.
		"CONTAINER_INSTANCE_NAME": "sourcing-v22",
		// B1 is available only through the existing protected server-side bearer
		// path. Guest Session and its expensive operations remain disabled.
		"PIPELINE_ENABLED": "true",
		// Guest Session: the public demo identity. The signing secret and the
		// operator token are Worker secrets, never variables.
		"GUEST_SESSION_ENABLED": "true",
		"GUEST_PUBLIC_ORIGIN": "https://procurement-sourcing-gateway.xiangyu474.workers.dev,http://localhost:5173,http://127.0.0.1:5173",
		"GUEST_SESSION_GLOBAL_PER_HOUR": "60",
		"GUEST_SESSION_IP_PER_HOUR": "10",
		"GUEST_GLOBAL_REQUESTS_PER_MINUTE": "600",
		"GUEST_SESSION_REQUESTS_PER_MINUTE": "120",
		// Coarse budget units: one unit is a demand compilation, four are a
		// complete sourcing and decision pipeline. They bound concurrency and
		// daily volume; they are not a monetary model budget.
		"GUEST_TASK_GLOBAL_CONCURRENT": "2",
		"GUEST_TASK_SESSION_CONCURRENT": "1",
		"GUEST_TASK_GLOBAL_DAILY_UNITS": "80",
		"GUEST_TASK_SESSION_DAILY_UNITS": "16",
		"GUEST_TASK_SESSION_DAILY_STARTS": "6",
		// The acceptance drives the public API, which starts workflows that
		// call a container, so it runs in its own instance.
		"ACCEPTANCE_CONTAINER_NAME": "acceptance-v8",
		"LANGSMITH_TRACING": "true",
		"LANGSMITH_PROJECT": "procurement-sourcing-m2"
	}
}
