# Local-only secret input. Never commit real values.
# In Cloudflare deployment, set the same names as Worker/Container secrets.

# Chat model (OpenAI-compatible endpoint)
GENESIS_BASE_URL=
GENESIS_ACCESS_TOKEN=
GENESIS_MODEL_ID=

# Web search / M2 research budgets (run-wide, shared across researchers)
TAVILY_API_KEY=
SOURCING_MAX_SEARCH_CALLS=12
SOURCING_MAX_WEB_FETCHES=24
SOURCING_MAX_RESEARCH_ROUNDS=3
SOURCING_MAX_CONCURRENT_RESEARCHERS=3
SOURCING_MAX_MODEL_CALLS=18
SOURCING_INTELLIGENCE_STALE_DAYS=180

# Tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=procurement-sourcing-dev
LANGSMITH_TRACING=false

# Cloudflare bindings used by the Python container
R2_BUCKET=
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public demo bearer token and shared secret between Worker and Python container
DEMO_ACCESS_TOKEN=
INTERNAL_GATEWAY_TOKEN=

# M3: the reasoning effort of the model, "none" for the steps whose answer is
# checked by code. Leave it empty to keep the endpoint's default.
# MODEL_REASONING_EFFORT=none

# M3: how many claims one typing call covers, and how many candidates one
# alignment call covers.
# M3_SPEC_TYPING_BATCH_SIZE=15
# M3_SPEC_ALIGNMENT_CANDIDATES=12
